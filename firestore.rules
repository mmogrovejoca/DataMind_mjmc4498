rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    
    function isSignedIn() {
      // Mandating verification per instructions
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      // get() is synchronous in rules and returns a Map
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(roles) {
      // exists() helps prevent crashes if user profile doesn't exist yet
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role in roles;
    }

    function isAdmin() {
      return hasRole(['admin']);
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validations ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) 
        && data.uid == request.auth.uid
        && data.role in ['admin', 'steward', 'analyst']
        && data.email is string && data.email.size() <= 256;
    }

    function isValidRule(data) {
      return data.keys().hasAll(['name', 'dimension', 'tableId', 'status'])
        && data.name is string && data.name.size() <= 100
        && data.dimension in ['completeness', 'consistency', 'uniqueness', 'validity', 'accuracy', 'timeliness']
        && data.tableId is string && data.tableId.size() <= 200
        && data.status in ['active', 'inactive'];
    }

    function isValidScan(data) {
      return data.keys().hasAll(['ruleId', 'timestamp', 'score'])
        && data.ruleId is string && data.ruleId.size() <= 128
        && data.score is number && data.score >= 0 && data.score <= 100;
    }

    // --- Routes ---

    // Boot ping
    match /system/ping {
      allow get: if isSignedIn();
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if (isOwner(userId) || isAdmin()) && isValidUser(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'lastLogin', 'role'])
      );
    }

    match /dq_rules/{ruleId} {
      // Pillar 8: Secure List Queries
      // Evaluate status if the client queries for it
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      
      // Pillar 2: Validation Blueprints
      allow create: if isSignedIn() && isValidId(ruleId) && isValidRule(incoming());
      
      // Pillar 4: Tiered Identity Logic
      allow update: if isSignedIn() && isValidRule(incoming()) && (
        // Allow updating status or config
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'config', 'name', 'updatedAt'])
      );
      
      allow delete: if isSignedIn(); 
    }

    match /scans/{scanId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create: if isSignedIn() && isValidId(scanId) && isValidScan(incoming());
      allow update, delete: if isAdmin();
    }
  }
}
